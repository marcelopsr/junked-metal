{
  "name": "junked-metal",
  "version": "0.92.0-dev",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:server": "node --test 'server/test/*.test.js'",
    "test:all": "npm test & a=$! ; npm run test:server & b=$! ; wait $a && wait $b",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "demo": "vite preview --port 4173 --strictPort",
    "balance:xlsx": "node scripts/balance-xlsx.mjs",
    "balance:import": "node scripts/balance-import.mjs",
    "balance:check": "node scripts/balance-check.mjs",
    "backup:pull": "node scripts/backup-pull.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs && pm2 save",
    "pm2:status": "pm2 status rc-dev rc-demo",
    "pm2:logs": "pm2 logs rc-dev rc-demo --lines 50",
    "demo:refresh": "npm run build && pm2 restart rc-demo",
    "sim": "node scripts/sim.mjs",
    "dps": "node scripts/dps.mjs",
    "oleadas": "node scripts/oleadas.mjs",
    "evo": "node scripts/evo.mjs",
    "shots": "node scripts/shots.mjs",
    "perf": "node scripts/perf.mjs",
    "perf:cel": "node scripts/perf-cel.mjs",
    "e2e": "node scripts/e2e.mjs",
    "publicar": "node scripts/publicar.mjs",
    "playtest:duel": "node scripts/duel-playtest.mjs",
    "test:net": "node scripts/net-test.mjs",
    "test:restart": "node scripts/test-restart.mjs",
    "test:down": "node scripts/test-restart.mjs down",
    "test:ls": "node scripts/test-restart.mjs ls",
    "creative:status": "node scripts/comfy-status.mjs",
    "creative:watch": "node scripts/comfy-status.mjs --watch",
    "creative:free": "node scripts/comfy-status.mjs --free",
    "creative:cancel": "node scripts/comfy-status.mjs --cancel-all",
    "creative:start": "node scripts/comfy-status.mjs start",
    "creative:stop": "node scripts/comfy-status.mjs stop",
    "creative:gen": "node scripts/creative-gen.mjs",
    "creative:batch": "node scripts/creative-batch.mjs",
    "creative:batch:status": "node scripts/creative-batch.mjs --status",
    "creative:batch:watch": "node scripts/creative-batch.mjs --watch",
    "creative:batch:cancel": "node scripts/creative-batch.mjs --cancel",
    "creative:pbr": "node scripts/creative-pbr.mjs",
    "assets:optimize": "node scripts/assets-optimize.mjs",
    "assets:check": "node scripts/assets-optimize.mjs --check",
    "carga": "node scripts/carga.mjs",
    "doctor": "node scripts/doctor.mjs",
    "doctor:fix": "node scripts/doctor.mjs --fix",
    "check": "tsc --noEmit -p . & a=$!; vitest run --changed --passWithNoTests & b=$!; node scripts/shots.mjs --changed & c=$!; wait $a && wait $b && wait $c",
    "app": "npx -y @tauri-apps/cli@2 build && rm -rf \"/Applications/Junked Metal Nativo.app\" && cp -R \"src-tauri/target/release/bundle/macos/Junked Metal.app\" \"/Applications/Junked Metal Nativo.app\""
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "@babylonjs/core": "^9.28.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.28.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@websr/websr": "^0.0.16",
    "earcut": "^3.2.4",
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/earcut": "^3.0.0",
    "exceljs": "^4.4.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
