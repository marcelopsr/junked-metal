texture id = truchet, cube = false, size = 256 256, borderoffset = 0, image = data:image/png;base64,

//
// Welcome to the Smooth Voxels Playground!
//
// Jump right in to create your own models, or try out the many examples
// by selecting them above, or play around with the generator below.
//
// Enjoy!
// Samuel van Egmond
//

model
size = 86 64 86
scale    = 0.025
origin   = +z
rotation = 90 0 0
position = 0 0.25 0

// NOTE: Shells do give shadows. Don't like that? Turn off shadows in the Playground.

// Shell materials
material wireframe = true // Wireframe not supported by .gltf!
  colors = Wire:#040
material lighting = smooth, map=truchet, maptransform = 3 3, roughness = 0, metalness = 1, transparent = true, side = double, opacity = 0.5
  colors = Truchet:#FF0
material type = basic, side = back
  colors = White:#FFF Black:#000
material side = back  
  colors = Blue:#8CF  // Make the O look solid
material lighting = smooth, type = normal, side = back
  colors = Normal:#FFF
  
// Model materials
material lighting = both, roughness = 0.1, metalness = 1, deform =  5, clamp = -y 
  colors = S(218):#A00, shell = Truchet 1 Normal 2
material lighting = flat, roughness = 1.0,                deform =  2, scatter = 0.2
  colors = V(162):#4A0, shell = Wire 0.01  Black 0.3
material lighting = both, roughness = 0.0, metalness = 1.0, opacity = 0.5, deform = 10, clamp = y
  colors = O(79):#8CF, shell = Blue 0
material lighting = flat, roughness = 0.5
  colors = X(207):#14A, shell = White 0.3

material lighting = smooth, deform = 8 0.8 0.7, roughness = 0.9
  colors = A(5):#0C0D10 B(6):#171A1D

voxels
